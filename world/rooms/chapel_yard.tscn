lines = PackedStringArray("Многих нет. Кого не нашли среди живых, не нашли и среди мёртвых.", "Отстроимся. Сперва кровля, потом кузня. Железо огню не по зубам.", "Моя старая кузня за лесом. Там остался приятель, мы вместе ковали.", "В ту ночь он не вернулся. Найдёшь его, будь осторожен.")
look_color = Color(0.3, 0.22, 0.18, 1)
gift_weapon = &"sword"
gift_flag = &"got_sword"
gift_line = "Живой… Палкой много не навоюешь. Держи, он старый, но честный."
after_flag = &"boss_smith"
lines_after = PackedStringArray("Значит, это был он… От него одни руки и остались.", "Спасибо, что не дал ему дальше так ходить.")

[node name="Herbalist" type="Area3D" parent="Objects"]
position = Vector3(-13.0, 0, 0)
script = ExtResource("npc")
npc_name = "Травница"
lines = PackedStringArray("Что успела из трав, то спасла. На всех не хватит.", "Говорят, перед пожаром по деревне ходил чародей. Кто его видел, уже не расскажет.", "Они были нашими соседями. А потом стали другими. На глазах.", "Многие пропали без вести. Лес забрал больше, чем огонь.")
look_color = Color(0.22, 0.26, 0.2, 1)

[node name="Glassblower" type="Area3D" parent="Objects"]
position = Vector3(7.5, 0, 0)
script = ExtResource("npc")
npc_name = "Стекольщик"
lines = PackedStringArray("Стекло пережило огонь лучше, чем люди. Будем стеклить заново.", "Витраж-то цел. Замок на нём смотрит так, будто доволен.", "То зеркало в часовне старше всех нас. Молчит, пока не вернутся его осколки.")
look_color = Color(0.26, 0.24, 0.3, 1)
