[node name="Smith" type="Area3D" parent="Objects"]
position = Vector3(-18.0, 0, 0)
script = ExtResource("npc")
npc_name = "Кузнец"
lines = PackedStringArray("Многих нет. Кого не нашли среди живых, не нашли и среди мёртвых.", "Отстроимся. Сперва кровля, потом кузня. Железо огню не по зубам.", "За лесом, за болотом, была деревня моего приятеля. Мы вместе ковали.", "Несколько лет назад её вырезали. Говорят, он сам. Не верю. Не хочу верить.", "Травницу никто не видел с той ночи. Если она в лесу — найди её.")
look_color = Color(0.3, 0.22, 0.18, 1)
gift_weapon = &"sword"
gift_flag = &"got_sword"
gift_line = "Живой… Палкой много не навоюешь. Держи, он старый, но честный."
sell_item = &"shield_hoplon"
sell_price = 250
sell_offer = "Есть круглый щит, гоплон. Старый, но удар держит. Возьмёшь?"
sell_line = "Держи. Подставляй его под удар — и вовремя: отобьёшь не хуже клинка."
after_flag = &"boss_smith"
lines_after = PackedStringArray("Значит, это был он… От него одни руки и остались.", "Спасибо, что не дал ему дальше так ходить.")

[node name="Herbalist" type="Area3D" parent="Objects"]
position = Vector3(-13.0, 0, 0)
script = ExtResource("npc")
npc_name = "Травница"
lines = PackedStringArray("Разбойники утащили меня в ту ночь, пока все тушили огонь.", "Говорят, перед пожаром по деревне ходил чародей. Кто его видел, уже не расскажет.", "Они были нашими соседями. А потом стали другими. На глазах.", "Многие пропали без вести. Лес забрал больше, чем огонь.")
look_color = Color(0.22, 0.26, 0.2, 1)
appear_flag = &"herbalist_rescued"
gift_item = &"flask_potency"
gift_flag = &"herbalist_potency"
gift_line = "Ты меня вытащил. Дай-ка твою флягу: с моими травами зелье будет крепче."

[node name="Glassblower" type="Area3D" parent="Objects"]
position = Vector3(7.5, 0, 0)
script = ExtResource("npc")
npc_name = "Стекольщик"
lines = PackedStringArray("Стекло пережило огонь лучше, чем люди. Будем стеклить заново.", "Витраж-то цел. Замок на нём смотрит так, будто доволен.", "То зеркало в часовне старше всех нас. Молчит, пока не вернутся его осколки.", "Травница пропала в ту ночь. Её прилавок так и стоит пустой.")
look_color = Color(0.26, 0.24, 0.3, 1)
after_flag = &"herbalist_rescued"
lines_after = PackedStringArray("Травница вернулась! Говорит, её держали разбойники на поваленном дубе.", "Витраж-то цел. Замок на нём смотрит так, будто доволен.", "То зеркало в часовне старше всех нас. Молчит, пока не вернутся его осколки.")

