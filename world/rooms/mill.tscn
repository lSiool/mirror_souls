[node name="Widow" type="Area3D" parent="Objects"]
position = Vector3(25.0, 6.0, 0)
script = ExtResource("npc")
npc_name = "Вдова мельника"
lines = PackedStringArray("Мельница стоит. Жернова молчат. Молоть нечего — поле никто не жнёт.", "Мужа схоронила по весне. Ветряк он сам ставил, крылья до сих пор крутятся. Будто он там.", "Ты с холма пришёл? Не ходи туда. Там столб.")
look_color = Color(0.18, 0.17, 0.2, 1)
after_flag = &"saw_post"
told_flag = &"scarecrow_tale"
lines_after = PackedStringArray("Видел столб, значит. Пустой… Слушай тогда.", "После той ночи, когда зверь рвал деревню, мужики поймали на дороге чужака. Худой, в чужих сапогах. Сказали — он зверя навёл.", "Привязали к столбу на холме на рассвете. Он не кричал. Только просил воды и всё смотрел на рожь.", "В полдень над полем встало марево, и рожь легла против ветра. Полудница прошла. Мужики разбежались.", "К вечеру верёвки висели пустые. А ночью в поле кто-то ходил и считал колосья вслух.", "Не ходи больше на холм. Если на столбе кто-то есть — это уже не он.")

