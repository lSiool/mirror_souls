[node name="LamplighterNote" type="Area3D" parent="Objects"]
position = Vector3(25.4, 0.0, 0)
script = ExtResource("note")
title = "Записи фонарщика"
lines = PackedStringArray("«Свечи гаснут сами. Я хожу и зажигаю их снова — и так каждую ночь».", "«Внизу опять звонили. Колокол мёртвых не звонил сорок лет».", "«Масла осталось на одну ночь. Дальше пойду без света».")

