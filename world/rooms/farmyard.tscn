[node name="Cowherd" type="Area3D" parent="Objects"]
position = Vector3(2.0, 0.0, 0)
script = ExtResource("npc")
npc_name = "Скотница"
lines = PackedStringArray("Скотину из поля пригнала затемно. В полдень туда не ходят.", "Во ржи кто-то ходит. Колосья клонятся против ветра — значит, она рядом.", "Полудница спрашивает загадки. Не ответишь — свернёт шею. Ответишь — всё равно свернёт.", "За ржаным полем столб на холме. Вчера там… не хочу говорить. Спроси вдову у мельницы.")
look_color = Color(0.3, 0.27, 0.22, 1)
after_flag = &"scarecrow_tale"
lines_after = PackedStringArray("Видел его? На столбе? Значит, и он тебя видел.", "Вороны с холма улетели. Все до одной.")

