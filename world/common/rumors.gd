class_name Rumors
extends RefCounted
## Слухи стекольщика (§8.14, зеркало правды): у стекольщика в хабе старое зеркало, которое показывает правду.
## На досуге он глядит в него и при каждом разговоре пересказывает герою одно место из открытых им последними —
## ловушку, засаду или тайник. Говорит намёком: где примерно и чего бояться, но не прямо.
## Порядок — от самой свежей находки к старым (GameState.visited_rooms хранит порядок открытия);
## рассказанное помечается флагом rumor_<комната> и больше не повторяется. Новое место — строка в LINES.

## С этого начинается самый первый слух.
const INTRO := "Есть у меня зеркальце — старое, правду кажет. Гляжу в него, когда печь остывает."
const INTRO_FLAG := &"rumor_intro"
## Комната → намёк. Только места, где правда есть ловушка, засада или тайник.
const LINES := {
	&"village_house": "Видел в зеркале дом у площади. Под самой крышей, на балках, висит кто-то вниз головой, а внизу шуршит. Поднимешься — не задирай голову раньше, чем оглядишься под ногами.",
	&"village_square": "Зеркало показало площадь у колодца. Из-за домов глядело что-то на четырёх лапах — ростом с человека, а ходит не по-людски. Огонь ему не помеха.",
	&"chapel": "В часовне, на балконе, одна доска темнее прочих. Зеркало показало, что под ней кто-то припрятал добро. Только простым шагом её не проломить.",
	&"cemetery_gate": "У кладбищенских ворот, повыше, кто-то оставил добро на чёрный день. А доска перед ним гнилая, и зеркало показало, что под ней. Мне не понравилось.",
	&"cemetery": "Склеп на кладбищенском холме: двери прикрыты, а свечи внутри горят. Кто их зажёг? Поднимешься по ступеням — жди гостей, и не одного.",
	&"forest_wall": "У лесной стены, где тропа ровная, под кронами висят тёмные комья. Не шишки. Пройдёшь под ними — проснутся.",
	&"fallen_giant": "Под поваленным великаном — овраг. На дне крысиное гнездо, а ближе к утёсу земля ощетинилась. Прыгать вниз будешь — гляди, куда.",
	&"root_maze": "В корнях, на верхних ярусах, туман ходит сам по себе, против ветра. Не туман это. А на дне, у дальнего края, торчит то же, что в овраге у великана.",
	&"swamp": "На болоте, на середине пути, вода стоит слишком гладко. Под ней железо, а в железе кто-то дышит. Утонул, а уходить не хочет.",
	&"cursed_village": "В мёртвой деревне у остывшей кузни сидит человек, руки на молоте. Зеркало показало его глаза. Не подходи, пока не готов.",
	&"pump_wheel": "Глубоко в шахтах, у Большого Колеса… Сойдёшь ярусом ниже в сторону родного края — там тебя поджидает неприятный сюрприз. Добро лежит, да доски под ним не держат, и сторож при нём не спит.",
	&"flooded_drift": "В затопленном штреке, за завалом, у свечи в нише… Под ногами нить, тоньше волоса, а над ней в потолке спит железо. Услышишь щелчок — стой. А перед завалом, где птица в клетке не поёт, огня не неси.",
	&"threshing_barn": "В гумне, на полке под самой крышей, лежит хозяйское добро. Хозяин воров не любил: одна доска там светлее прочих — не наступай на неё, коли грудь дорога.",
	&"vegetable_patch": "В погребе под огородами стоит сундук. Пахнет от него не репой, и крыса рядом лежит — не от старости. Стукни по нему, прежде чем открывать.",
	&"mine_shafts": "В шахтах, на нижнем горизонте, у рельсов стоит пустая вагонетка. Только пустая ли? Пройдёшь мимо — не поворачивайся к ней спиной.",
	&"lava_river": "Видел реку огня и мост на цепях. Где доски прогорели, огонь не так глубок, как кажется, — но и долго в нём не простоишь. Выскакивай сразу.",
}


## Комната, о которой стекольщик расскажет сейчас: самая свежая находка с нерассказанным слухом; пусто — всё рассказано.
static func next_untold() -> StringName:
	var rooms: Array = GameState.visited_rooms.keys()
	for i in range(rooms.size() - 1, -1, -1):
		var room := StringName(rooms[i])
		if LINES.has(room) and not GameState.has_flag(flag(room)):
			return room
	return &""


static func flag(room: StringName) -> StringName:
	return StringName("rumor_%s" % room)


## Рассказать слух о комнате: текст (первый — со вступлением про зеркало) и пометка, что рассказан.
static func tell(room: StringName) -> String:
	var text: String = LINES[room]
	if not GameState.has_flag(INTRO_FLAG):
		GameState.set_flag(INTRO_FLAG)
		text = INTRO + " " + text
	GameState.set_flag(flag(room))
	return text
