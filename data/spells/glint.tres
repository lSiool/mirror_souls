[gd_resource type="Resource" script_class="SpellData" load_steps=2 format=3]

[ext_resource type="Script" path="res://combat/magic/spell_data.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
id = &"glint"
display_name = "Блик"
description = "Вспышка отражённого света с навершия посоха. Ослепляет тех, кто перед героем: человек трёт глаза, оборотень ревёт, вампир теряется. Скелету и стеклу всё равно."
